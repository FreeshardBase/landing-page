---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { de } from '../i18n/de';
import { en } from '../i18n/en';
import { BRAND_MARK, BRAND_MARK_2X } from '../lib/branding';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/daylight.css';

interface Props {
  title: string;
  description?: string;
  lang: string;
  ogImage?: string;
  ogType?: string;
  rssHref?: string;
}

const { lang, title, description, ogImage, ogType = 'website', rssHref } = Astro.props;
const t = lang === 'en' ? en : de;
const metaDescription = description || t.hero.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={BRAND_MARK} />
    <link rel="canonical" href={canonical} />
    {rssHref && <link rel="alternate" type="application/rss+xml" title={t.blog.title} href={rssHref} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_GB' : 'de_DE'} />
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="navbar">
        <div class="container">
          <div class="logo">
            <a href={`/${lang}/`} class="logo-link">
              <img src={BRAND_MARK} srcset={`${BRAND_MARK_2X} 2x`} alt="Freeshard" class="logo-mark" />
              <span class="logo-text">Freeshard</span>
            </a>
          </div>
          <ul class="nav-links">
            <li><a href={`/${lang}/#use-cases`}>{t.nav.useCases}</a></li>
            <li><a href={`/${lang}/#features`}>{t.nav.features}</a></li>
            <li><a href={`/${lang}/#pricing`}>{t.nav.pricing}</a></li>
            <li><a href={`/${lang}/#motivation`}>{t.nav.motivation}</a></li>
            <li><a href={`/${lang}/blog/`}>{t.nav.blog}</a></li>
            <li class="lang-switcher-li"><LanguageSwitcher /></li>
          </ul>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <img src={BRAND_MARK} alt="Freeshard" class="footer-logo" />
        <div class="footer-links">
          <a href={`/${lang}/trial/`}>{t.footer.trial}</a>
          <a href={`/${lang}/activate/`}>{t.footer.activate}</a>
          <a href={`/${lang}/faq/`}>{t.footer.faq}</a>
          <a href={`/${lang}/impressum/`}>{t.footer.imprint}</a>
          <a href={`/${lang}/datenschutz/`}>{t.footer.privacy}</a>
          <a href={`/${lang}/agb/`}>{t.footer.terms}</a>
          <a href="mailto:contact@freeshard.net">{t.nav.contact}</a>
        </div>
        <p>{t.footer.copyright}</p>
      </div>
    </footer>
    <style is:global>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
        scroll-padding-top: 80px;
      }

      body {
        font-family: var(--font-ui);
        font-size: var(--fs-body);
        color: var(--ink);
        line-height: 1.6;
        background-color: var(--bg);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
      }

      main {
        flex: 1 0 auto;
      }

      a {
        color: var(--line);
      }

      code, kbd, pre, samp {
        font-family: var(--font-mono);
      }

      .container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 var(--space-6);
      }

      .site-header {
        background-color: var(--bg);
        border-bottom: var(--border-w) solid var(--border);
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .navbar {
        padding: var(--space-4) 0;
      }

      .navbar .container {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .logo-link {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        text-decoration: none;
      }

      .logo-mark {
        height: 28px;
        width: auto;
      }

      .logo-text {
        font-size: 17px;
        font-weight: 600;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      .nav-links {
        display: flex;
        align-items: center;
        list-style: none;
        gap: var(--space-6);
      }

      .nav-links a {
        text-decoration: none;
        color: var(--ink-muted);
        font-size: var(--fs-small);
        font-weight: 500;
        transition: color var(--motion-instant) var(--ease-standard);
      }

      .nav-links a:hover {
        color: var(--ink);
      }

      .site-footer {
        flex-shrink: 0;
        border-top: var(--border-w) solid var(--border);
        padding: var(--space-7) 0;
        text-align: center;
      }

      .footer-logo {
        width: 28px;
        height: auto;
        margin-bottom: var(--space-5);
      }

      .footer-links {
        margin-bottom: var(--space-5);
        display: flex;
        justify-content: center;
        gap: var(--space-3) var(--space-6);
        flex-wrap: wrap;
      }

      .footer-links a {
        color: var(--ink-muted);
        font-size: var(--fs-small);
        text-decoration: none;
      }

      .footer-links a:hover {
        color: var(--ink);
        text-decoration: underline;
      }

      .site-footer p {
        color: var(--ink-muted);
        font-size: var(--fs-small);
      }

      section {
        padding: var(--space-8) 0;
      }

      main > section + section {
        border-top: var(--border-w) solid var(--border);
      }

      h1, h2, h3, h4 {
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      h2 {
        font-size: var(--fs-display);
        font-weight: var(--fw-display);
        line-height: 1.2;
        margin-bottom: var(--space-4);
        text-align: center;
      }

      h3 {
        font-size: var(--fs-h2);
        font-weight: 600;
        line-height: 1.3;
        margin-bottom: var(--space-2);
      }

      .section-description {
        text-align: center;
        color: var(--ink-muted);
        font-size: 17px;
        margin-bottom: var(--space-7);
        max-width: 600px;
        margin-left: auto;
        margin-right: auto;
      }

      @media (max-width: 768px) {
        .nav-links {
          display: none;
        }

        h2 {
          font-size: var(--fs-h1);
        }

        section {
          padding: var(--space-7) 0;
        }

        .container {
          padding: 0 var(--space-4);
        }
      }
    </style>
  </body>
</html>
