---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { de } from '../../i18n/de';
import { en } from '../../i18n/en';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const content = lang === 'en' ? en : de;
const t = content.imprint;
---

<Layout title={t.title} lang={lang}>
  <section class="legal-page">
    <div class="container">
      <h1>{t.pageTitle}</h1>
      
      <div class="imprint-details">
        <h2>{t.contactLabel}</h2>
        <p set:html={t.address} />

        <h3>{t.ceoLabel}</h3>
        <p>{t.ceoName}</p>
        
        <h3>{t.contactInfoLabel}</h3>
        <p>{t.contactInfo}</p>
        
        <h3>{t.registerLabel}</h3>
        <p set:html={t.registerInfo} />

        <h3>{t.vatLabel}</h3>
        <p set:html={t.vatInfo} />

        <h3>{t.responsibleLabel}</h3>
        <p set:html={t.responsibleInfo} />
      </div>

    </div>
  </section>
</Layout>

<style>
  .legal-page {
    padding: var(--space-8) 0;
    min-height: 60vh;
  }

  .legal-page .container {
    max-width: 760px;
  }

  .legal-page h1 {
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: 1.2;
    margin-bottom: var(--space-7);
  }

  .imprint-details {
    font-size: var(--fs-prose);
  }

  .imprint-details h2 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-4);
    text-align: left;
  }

  .imprint-details h3 {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }

  .imprint-details p {
    line-height: 1.75;
    color: var(--ink-muted);
  }
</style>
