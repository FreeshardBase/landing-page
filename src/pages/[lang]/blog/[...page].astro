---
import type { GetStaticPaths, Page } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import { languages } from '../../../i18n/ui';
import { de } from '../../../i18n/de';
import { en } from '../../../i18n/en';
import { getPosts, urlOf, formatDate, coverOf, POSTS_PER_PAGE, type BlogPost } from '../../../lib/blog';

type Props = { page: Page<BlogPost> };

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const routes = [];
  for (const lang of Object.keys(languages)) {
    const posts = await getPosts(lang);
    routes.push(...paginate(posts, { params: { lang }, pageSize: POSTS_PER_PAGE }));
  }
  return routes;
};

const { page } = Astro.props;
const lang = Astro.params.lang as string;
const t = (lang === 'en' ? en : de).blog;
---

<Layout title={t.title} lang={lang} description={t.intro}>
  <section class="blog-index">
    <div class="container">
      <h1>{t.pageTitle}</h1>
      <p class="section-description">{t.intro}</p>

      {page.data.length === 0 && <p class="blog-empty">{t.empty}</p>}

      <ul class="post-list">
        {page.data.map((post) => (
          <li class="post-card">
            {post.data.cover && (
              <a href={urlOf(post)} class="post-card-cover">
                <Image src={coverOf(post)!} alt={post.data.coverAlt ?? ''} widths={[400, 800]} sizes="(max-width: 720px) 100vw, 400px" />
              </a>
            )}
            <div class="post-card-body">
              <h2><a href={urlOf(post)}>{post.data.title}</a></h2>
              <p class="post-meta">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
                <span class="post-meta-sep">·</span>
                <span>{t.by} {post.data.author}</span>
              </p>
              <p class="post-excerpt">{post.data.description}</p>
              <a href={urlOf(post)} class="post-more">{t.readMore} →</a>
            </div>
          </li>
        ))}
      </ul>

      {(page.url.prev || page.url.next) && (
        <nav class="pagination" aria-label="Pagination">
          {page.url.prev ? <a href={page.url.prev}>← {t.newerPosts}</a> : <span />}
          {page.url.next ? <a href={page.url.next}>{t.olderPosts} →</a> : <span />}
        </nav>
      )}

      <p class="blog-feed">
        <a href={`/${lang}/blog/rss.xml`}>{t.rss}</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .blog-index h1 {
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: 1.2;
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .post-list {
    list-style: none;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .post-card {
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    padding: var(--space-6) 0;
  }

  .post-card + .post-card {
    border-top: var(--border-w) solid var(--border);
  }

  .post-card-cover {
    flex: 0 0 240px;
    display: block;
    border-radius: var(--radius-tile);
    overflow: hidden;
    border: var(--border-w) solid var(--border);
  }

  .post-card-cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .post-card-body {
    flex: 1 1 auto;
  }

  .post-card h2 {
    font-size: var(--fs-h2);
    line-height: 1.3;
    text-align: left;
    margin-bottom: var(--space-2);
  }

  .post-card h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-card h2 a:hover {
    color: var(--line);
  }

  .post-meta {
    color: var(--ink-muted);
    font: 400 12px/1.4 var(--font-mono);
    letter-spacing: var(--ls-mono);
    margin-bottom: var(--space-3);
  }

  .post-meta-sep {
    margin: 0 var(--space-2);
  }

  .post-excerpt {
    color: var(--ink-muted);
    margin-bottom: var(--space-3);
  }

  .post-more,
  .pagination a {
    color: var(--line);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
  }

  .post-more:hover,
  .pagination a:hover {
    text-decoration: underline;
  }

  .blog-empty {
    text-align: center;
    color: var(--ink-muted);
  }

  .pagination {
    max-width: 820px;
    margin: var(--space-6) auto 0;
    padding-top: var(--space-5);
    border-top: var(--border-w) solid var(--border);
    display: flex;
    justify-content: space-between;
  }

  .blog-feed {
    text-align: center;
    margin-top: var(--space-6);
  }

  .blog-feed a {
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }

  @media (max-width: 720px) {
    .post-card {
      flex-direction: column;
    }

    .post-card-cover {
      flex-basis: auto;
      width: 100%;
    }
  }
</style>
