---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { languages } from '../../../i18n/ui';
import { de } from '../../../i18n/de';
import { en } from '../../../i18n/en';
import { getPosts, slugOf, urlOf, formatDate, isPreRebrand, coverOf, type BlogPost } from '../../../lib/blog';

type Props = { post: BlogPost };

export const getStaticPaths: GetStaticPaths = async () => {
  const routes = [];
  for (const lang of Object.keys(languages)) {
    for (const post of await getPosts(lang)) {
      routes.push({ params: { lang, slug: slugOf(post) }, props: { post } });
    }
  }
  return routes;
};

const { post } = Astro.props;
const lang = Astro.params.lang as string;
const t = (lang === 'en' ? en : de).blog;
const { Content } = await render(post);
const related = (await getPosts(lang)).filter((p) => p.id !== post.id).slice(0, 3);
---

<Layout
  title={`${post.data.title} — Freeshard`}
  lang={lang}
  description={post.data.description}
  ogImage={post.data.cover?.src}
  ogType="article"
  rssHref={`/${lang}/blog/rss.xml`}
>
  <article class="post">
    <div class="container">
      <header class="post-header">
        <h1>{post.data.title}</h1>
        <p class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
          <span class="post-meta-sep">·</span>
          <span>{t.by} {post.data.author}</span>
          {post.data.updatedDate && (
            <>
              <span class="post-meta-sep">·</span>
              <span>{t.updatedOn} {formatDate(post.data.updatedDate, lang)}</span>
            </>
          )}
        </p>
      </header>

      {post.data.cover && (
        <Image
          class="post-cover"
          src={coverOf(post)!}
          alt={post.data.coverAlt ?? ''}
          widths={[720, 1440]}
          sizes="(max-width: 820px) 100vw, 800px"
        />
      )}

      {post.data.aiTranslated && (
        <aside class="post-notice">
          {t.aiTranslated}
          <a href={`/en/blog/${slugOf(post)}/`}>{t.readOriginal}</a>
        </aside>
      )}

      {isPreRebrand(post) && <aside class="post-notice">{t.preRebrand}</aside>}

      <div class="post-body">
        <Content />
      </div>

      <footer class="post-footer">
        <a href={`/${lang}/blog/`} class="post-back">← {t.backToOverview}</a>
      </footer>

      {related.length > 0 && (
        <section class="related fs-sheet">
          <h2>{t.pageTitle}</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={urlOf(p)}>{p.data.title}</a>
                <span class="related-date">{formatDate(p.data.pubDate, lang)}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </article>
</Layout>

<style>
  .post {
    padding: var(--space-7) 0 var(--space-8);
  }

  .post .container {
    max-width: 760px;
  }

  .post-header {
    margin-bottom: var(--space-5);
  }

  .post-header h1 {
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: 1.2;
    margin-bottom: var(--space-3);
  }

  .post-meta {
    color: var(--ink-muted);
    font: 400 12px/1.4 var(--font-mono);
    letter-spacing: var(--ls-mono);
  }

  .post-meta-sep {
    margin: 0 var(--space-2);
  }

  .post-cover {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sheet);
    border: var(--border-w) solid var(--border);
    margin-bottom: var(--space-6);
  }

  .post-notice {
    background: var(--surface);
    border: var(--border-w) solid var(--border-cool);
    border-radius: var(--radius-control);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-5);
    color: var(--ink-muted);
    font-size: var(--fs-small);
  }

  .post-notice a {
    color: var(--line);
    margin-left: var(--space-2);
  }

  .post-body {
    font-size: var(--fs-prose);
    line-height: 1.75;
  }

  .post-body :global(h1),
  .post-body :global(h2),
  .post-body :global(h3) {
    text-align: left;
    line-height: 1.3;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
  }

  .post-body :global(h1) {
    font-size: var(--fs-h1);
    font-weight: 600;
  }

  .post-body :global(h2) {
    font-size: var(--fs-h2);
    font-weight: 600;
  }

  .post-body :global(h3) {
    font-size: var(--fs-h3);
  }

  .post-body :global(p),
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: var(--space-5);
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    padding-left: var(--space-5);
  }

  .post-body :global(li) {
    margin-bottom: var(--space-2);
  }

  .post-body :global(a) {
    color: var(--line);
  }

  .post-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-tile);
    border: var(--border-w) solid var(--border);
    margin: var(--space-4) 0;
  }

  .post-body :global(blockquote) {
    border-left: var(--border-w-glyph) solid var(--border-cool);
    padding-left: var(--space-4);
    color: var(--ink-muted);
    margin-bottom: var(--space-5);
  }

  .post-body :global(pre) {
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius-control);
    padding: var(--space-4);
    overflow-x: auto;
    margin-bottom: var(--space-5);
    line-height: 1.5;
  }

  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  .post-body :global(:not(pre) > code) {
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: 5px;
    padding: 1px 5px;
  }

  .post-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-5);
    font-size: var(--fs-body);
  }

  .post-body :global(th),
  .post-body :global(td) {
    border-bottom: var(--border-w) solid var(--border);
    padding: var(--space-2) var(--space-3);
    text-align: left;
  }

  .post-body :global(th) {
    font: 600 var(--fs-label)/1.4 var(--font-ui);
    text-transform: uppercase;
    letter-spacing: var(--ls-label);
    color: var(--ink-muted);
  }

  .post-footer {
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: var(--border-w) solid var(--border);
  }

  .post-back {
    color: var(--line);
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
  }

  .post-back:hover {
    text-decoration: underline;
  }

  .related {
    margin-top: var(--space-6);
    padding: var(--space-5);
  }

  .related h2 {
    font-size: var(--fs-h3);
    text-align: left;
    margin-bottom: var(--space-3);
  }

  .related ul {
    list-style: none;
  }

  .related li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) 0;
  }

  .related li:not(:last-child) {
    border-bottom: var(--border-w) solid var(--border);
  }

  .related a {
    color: var(--ink);
    text-decoration: none;
  }

  .related a:hover {
    color: var(--line);
  }

  .related-date {
    color: var(--ink-muted);
    font: 400 12px/1.6 var(--font-mono);
    letter-spacing: var(--ls-mono);
    white-space: nowrap;
  }

  .post-body :global(.mermaid-diagram) {
    display: flex;
    justify-content: center;
    margin: var(--space-6) 0;
    overflow-x: auto;
    background: var(--surface);
    padding: var(--space-5);
    border-radius: var(--radius-sheet);
    border: var(--border-w) solid var(--border);
  }

  .post-body :global(.mermaid-diagram svg) {
    max-width: 100%;
    height: auto;
  }
</style>

<script>
  const mermaidBlocks = document.querySelectorAll('pre[data-language="mermaid"]');
  if (mermaidBlocks.length > 0) {
    const { default: mermaid } = await import('mermaid');
    const token = (name: string) => getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    mermaid.initialize({
      startOnLoad: false,
      theme: 'base',
      fontFamily: token('--font-ui'),
      themeVariables: {
        background: token('--surface'),
        primaryColor: token('--surface'),
        primaryBorderColor: token('--line'),
        primaryTextColor: token('--ink'),
        secondaryColor: token('--bg'),
        tertiaryColor: token('--bg'),
        lineColor: token('--line'),
        textColor: token('--ink'),
        noteBkgColor: token('--bg'),
        noteBorderColor: token('--border-cool'),
      },
    });
    for (const [index, pre] of Array.from(mermaidBlocks).entries()) {
      const code = pre.textContent?.trim() ?? '';
      const container = document.createElement('div');
      container.className = 'mermaid-diagram';
      pre.parentNode?.replaceChild(container, pre);
      try {
        const { svg } = await mermaid.render(`mermaid-svg-${index}`, code);
        container.innerHTML = svg;
      } catch (err) {
        console.error('Mermaid render error:', err);
        container.appendChild(pre);
      }
    }
  }
</script>

