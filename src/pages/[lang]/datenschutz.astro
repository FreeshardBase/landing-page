---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { de } from '../../i18n/de';
import { en } from '../../i18n/en';
import privacyDE from '../../content/datenschutz-de.html?raw';
import privacyEN from '../../content/datenschutz-en.html?raw';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const content = lang === 'en' ? en : de;
---

<Layout title={content.privacy.title} lang={lang}>
  <section class="legal-page">
    <div class="container">
      <div class="privacy-content" set:html={lang === 'de' ? privacyDE : privacyEN} />
    </div>
  </section>
</Layout>

<style>
  .legal-page {
    padding: var(--space-8) 0;
    min-height: 60vh;
  }

  .legal-page .container {
    max-width: 760px;
  }

  .privacy-content {
    font-size: var(--fs-prose);
  }

  .privacy-content :global(h1) {
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: 1.2;
    margin-bottom: var(--space-7);
  }

  .privacy-content :global(h2) {
    font-size: var(--fs-h2);
    font-weight: 600;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    text-align: left;
  }

  .privacy-content :global(h3) {
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }

  .privacy-content :global(p) {
    margin-bottom: var(--space-4);
    line-height: 1.75;
  }

  .privacy-content :global(ul) {
    margin: var(--space-3) 0 var(--space-4) var(--space-5);
    line-height: 1.75;
  }

  .privacy-content :global(a) {
    color: var(--line);
    word-break: break-word;
  }

  .privacy-content :global(ul.index) {
    list-style: none;
    margin-left: 0;
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius-sheet);
    margin-bottom: var(--space-7);
  }

  .privacy-content :global(ul.index li) {
    margin-bottom: var(--space-1);
  }

  .privacy-content :global(.index-link) {
    text-decoration: none;
  }

  .privacy-content :global(.index-link:hover) {
    text-decoration: underline;
  }

  .privacy-content :global(ul.m-elements) {
    list-style: none;
    margin-left: 0;
    padding: 0;
  }

  .privacy-content :global(ul.m-elements > li) {
    padding: var(--space-3) 0;
    border-bottom: var(--border-w) solid var(--border);
  }

  .privacy-content :global(ul.m-elements > li:last-child) {
    border-bottom: none;
  }

  .privacy-content :global(.seal) {
    margin-top: var(--space-7);
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }
</style>
