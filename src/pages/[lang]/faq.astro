---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { de } from '../../i18n/de';
import { en } from '../../i18n/en';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const content = lang === 'en' ? en : de;
const t = content.faq;
---

<Layout title={t.title} lang={lang}>
  <section class="faq-page">
    <div class="container">
      <h1>{t.pageTitle}</h1>
      <p class="section-description">{t.intro}</p>
      
      <div class="faq-search-wrapper">
        <input
          id="faq-search"
          class="fs-input"
          type="search"
          placeholder={t.searchPlaceholder}
          autofocus
          autocomplete="off"
          aria-label={t.searchPlaceholder}
        />
      </div>
      <p id="faq-no-results" hidden>{t.noResults}</p>

      <div class="faq-grid">
        {t.questions.map(faq => (
          <div class="faq-item fs-sheet" id={faq.id} data-tags={faq.tags.join(' ')}>
            <h3>{faq.question}</h3>
            <p set:html={faq.answer} />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .faq-page {
    padding: var(--space-8) 0;
    min-height: 60vh;
  }

  .faq-page h1 {
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: 1.2;
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .faq-search-wrapper,
  .faq-grid {
    max-width: 760px;
    margin: 0 auto;
  }

  .faq-search-wrapper {
    margin-bottom: var(--space-6);
  }

  #faq-no-results {
    color: var(--ink-muted);
    text-align: center;
    padding: var(--space-6) 0;
  }

  .faq-grid {
    display: grid;
    gap: var(--space-4);
  }

  .faq-item {
    padding: var(--space-6);
    scroll-margin-top: 120px;
    transition: border-color var(--motion-considered) var(--ease-standard);
  }

  .faq-item:target {
    border-color: var(--line);
  }

  .faq-item h3 {
    margin-bottom: var(--space-3);
  }

  .faq-item p {
    line-height: 1.7;
    color: var(--ink-muted);
  }

  .faq-item p :global(a) {
    color: var(--line);
    word-break: break-word;
  }

  .faq-item p :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--ink);
    border: var(--border-w) solid var(--border);
    padding: 1px 5px;
    border-radius: 5px;
  }
</style>

<script>
  const input = document.getElementById('faq-search') as HTMLInputElement;
  const items = document.querySelectorAll<HTMLElement>('.faq-item');
  const noResults = document.getElementById('faq-no-results') as HTMLElement;

  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    items.forEach(item => {
      const text = item.textContent?.toLowerCase() ?? '';
      const tags = (item.dataset.tags ?? '').toLowerCase();
      const match = !q || text.includes(q) || tags.includes(q);
      item.hidden = !match;
      if (match) visible++;
    });
    noResults.hidden = visible > 0 || !q;
  });
</script>
