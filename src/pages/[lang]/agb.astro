---
import Layout from '../../layouts/Layout.astro';
import { languages } from '../../i18n/ui';
import { de } from '../../i18n/de';
import { en } from '../../i18n/en';
import agbDE from '../../content/agb-de.html?raw';
import agbEN from '../../content/agb-en.html?raw';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const content = lang === 'en' ? en : de;
---

<Layout title={content.terms.title} lang={lang}>
  <section class="legal-page">
    <div class="container">
      <div class="terms-content" set:html={lang === 'de' ? agbDE : agbEN} />
    </div>
  </section>
</Layout>

<style>
  .legal-page {
    padding: var(--space-8) 0;
    min-height: 60vh;
  }

  .legal-page .container {
    max-width: 760px;
  }

  .terms-content {
    font-size: var(--fs-prose);
  }

  .terms-content :global(h1) {
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: 1.2;
    margin-bottom: var(--space-7);
  }

  .terms-content :global(h2) {
    font-size: var(--fs-h2);
    font-weight: 600;
    margin-top: var(--space-7);
    margin-bottom: var(--space-3);
    text-align: left;
  }

  .terms-content :global(h3) {
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
  }

  .terms-content :global(p) {
    margin-bottom: var(--space-4);
    line-height: 1.75;
  }

  .terms-content :global(ul) {
    margin: var(--space-3) 0 var(--space-4) var(--space-5);
    line-height: 1.75;
  }

  .terms-content :global(a) {
    color: var(--line);
    word-break: break-word;
  }
</style>
