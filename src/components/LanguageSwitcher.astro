---
import { languages, defaultLang } from '../i18n/ui';

const { pathname } = Astro.url;

const getLangFromUrl = (pathname: string) => {
  const langCode = pathname.split('/')[1];

  if (langCode && Object.keys(languages).includes(langCode)) {
    return langCode as keyof typeof languages;
  }
  return defaultLang;
}

const getTranslatedPath = (lang: string) => {
  const pathWithoutLang = pathname.split('/').slice(2).join('/');
  return `/${lang}/${pathWithoutLang}`;
}

const currentLang = getLangFromUrl(pathname);
---

<div class="lang-switch">
  {Object.keys(languages).map((lang) => (
    <a
      href={getTranslatedPath(lang)}
      class:list={{ active: lang === currentLang }}
      class="lang-link"
      hreflang={lang}
      lang={lang}
      aria-current={lang === currentLang ? 'true' : undefined}
    >
      {lang}
    </a>
  ))}
</div>

<script>
  // Keep the reader's place across a language switch. The two pages differ in text length, so a pixel offset
  // would land somewhere else; instead remember the element with an id (same in both languages) that sits under
  // the header, and how far into it the reader was.
  const KEY = 'langSwitchAnchor';

  function readingLine() {
    return document.querySelector('.site-header')?.getBoundingClientRect().bottom ?? 0;
  }

  document.querySelectorAll('.lang-link').forEach(link => {
    link.addEventListener('click', () => {
      const line = readingLine();
      // The deepest element spanning the line; if the line falls in a gap, the next element below it.
      let anchor: Element | undefined, below: Element | undefined, belowTop = Infinity;
      for (const el of document.querySelectorAll('main [id]')) {
        const r = el.getBoundingClientRect();
        if (!r.height) continue;
        if (r.top <= line && r.bottom > line) anchor = el; // later matches are nested deeper
        else if (r.top > line && r.top < belowTop) { below = el; belowTop = r.top; }
      }
      anchor ??= below;
      const r = anchor?.getBoundingClientRect();
      sessionStorage.setItem(KEY, JSON.stringify({
        id: anchor?.id,
        within: r ? (line - r.top) / r.height : 0,
        // Fallback when nothing with an id is under the line: the same share of the page.
        share: scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight),
      }));
    });
  });

  const saved = sessionStorage.getItem(KEY);
  if (saved) {
    sessionStorage.removeItem(KEY);
    const { id, within, share } = JSON.parse(saved);
    // An autofocus field (the FAQ search) would otherwise be focused after the restore and scroll back up
    // to it. Focusing it now without scrolling keeps the focus and makes the browser skip its autofocus.
    document.querySelector<HTMLElement>('[autofocus]')?.focus({ preventScroll: true });
    // Wait for fonts: they change the text height and so where the anchor ends up.
    addEventListener('load', () => document.fonts.ready.then(() => {
      const el = id && document.getElementById(id);
      const top = el
        ? el.getBoundingClientRect().top + scrollY + within * el.getBoundingClientRect().height - readingLine()
        : share * (document.documentElement.scrollHeight - innerHeight);
      // Jump, don't animate: the page's smooth scrolling would glide down from the top.
      scrollTo({ top, behavior: 'instant' });
    }));
  }
</script>

<style>
  .lang-switch {
    display: flex;
    gap: var(--space-1);
    padding-left: var(--space-5);
    border-left: var(--border-w) solid var(--border);
  }

  .lang-switch a {
    text-decoration: none;
    color: var(--ink-muted);
    font: 500 var(--fs-small)/1 var(--font-mono);
    letter-spacing: var(--ls-mono);
    text-transform: uppercase;
    padding: 6px 8px;
    border-radius: var(--radius-control);
    border: var(--border-w) solid transparent;
    transition: color var(--motion-instant) var(--ease-standard);
  }

  .lang-switch a:hover {
    color: var(--ink);
  }

  .lang-switch a.active {
    color: var(--ink);
    border-color: var(--border-cool);
  }
</style>
