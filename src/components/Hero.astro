---
import { de } from '../i18n/de';
import { en } from '../i18n/en';
import { BRAND_LOGO_DARK, BRAND_LOGO_LIGHT, BRAND_LOGO_LIGHT_2X } from '../lib/branding';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const content = lang === 'en' ? en : de;
const t = content.hero;
---

<section id="hero" class="hero">
  <div class="container">
    <div class="hero-content">
      <picture>
        <source srcset={BRAND_LOGO_DARK} media="(prefers-color-scheme: dark)" />
        <img src={BRAND_LOGO_LIGHT} srcset={`${BRAND_LOGO_LIGHT_2X} 2x`} alt="Freeshard Logo" class="hero-logo" />
      </picture>
      <h1>{t.subtitle}</h1>
      <p class="hero-description">{t.description}</p>
      <div class="hero-cta">
        <a href={`/${lang}/trial/`} class="fs-btn fs-btn--primary">{t.ctaPrimary}</a>
        <a href="#newsletter" class="fs-btn">{t.ctaSecondary}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 120px 0 var(--space-8);
    text-align: center;
  }

  .hero-logo {
    width: 220px;
    height: auto;
    margin-bottom: var(--space-7);
  }

  .hero-content h1 {
    font-size: var(--fs-hero);
    font-weight: var(--fw-display);
    line-height: 1.2;
    letter-spacing: -0.02em;
    max-width: 820px;
    margin: 0 auto var(--space-5);
  }

  .hero-description {
    font-size: 18px;
    color: var(--ink-muted);
    max-width: 640px;
    margin: 0 auto var(--space-7);
    line-height: 1.6;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 72px 0 var(--space-7);
    }

    .hero-content h1 {
      font-size: var(--fs-h1);
    }

    .hero-logo {
      width: 160px;
    }

    .hero-description {
      font-size: 16px;
    }
  }
</style>
