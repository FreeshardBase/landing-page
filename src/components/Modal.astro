---
import { X } from '@lucide/astro';

interface Props {
  id: string;
  title: string;
  content: string;
}

const { id, title, content } = Astro.props;
---

<dialog class="modal" data-modal-id={id} aria-labelledby={`${id}-title`}>
  <div class="modal-content">
    <button type="button" class="modal-close" aria-label="Close modal"><X size={18} stroke-width={1.5} /></button>
    <h3 id={`${id}-title`}>{title}</h3>
    <p set:html={content} />
  </div>
</dialog>

<style>
  .modal {
    margin: auto;
    padding: 0;
    max-width: 500px;
    width: 90%;
    color: var(--ink);
    background: var(--surface);
    border: var(--border-w) solid var(--border);
    border-radius: var(--radius-sheet);
  }

  /* The page recedes toward the paper ground and loses some colour; the modal lifts on its border alone. */
  .modal::backdrop {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: grayscale(0.5);
  }

  .modal[open] {
    animation: modal-in var(--motion-considered) var(--ease-standard);
  }

  @keyframes modal-in {
    from { opacity: 0; translate: 0 8px; }
    to { opacity: 1; translate: 0 0; }
  }

  .modal-content {
    position: relative;
    padding: var(--space-6);
  }

  .modal-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-muted);
    background: transparent;
    border: var(--border-w) solid transparent;
    border-radius: var(--radius-control);
    cursor: pointer;
    transition: color var(--motion-instant) var(--ease-standard),
                border-color var(--motion-instant) var(--ease-standard);
  }

  .modal-close:hover {
    color: var(--ink);
    border-color: var(--border-cool);
  }

  .modal-content h3 {
    margin: 0 var(--space-7) var(--space-4) 0;
  }

  .modal-content p {
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .modal-content p :global(a) {
    color: var(--line);
  }

  @media (max-width: 768px) {
    .modal-content {
      padding: var(--space-5);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach(modal => {
    modal.querySelector('.modal-close')?.addEventListener('click', () => modal.close());

    // A click on the dialog element itself lands on the backdrop, outside the content.
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.close();
      }
    });
  });
</script>
