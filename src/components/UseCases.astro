---
import { de } from '../i18n/de';
import { en } from '../i18n/en';
import { Image, FileText, KeyRound, CookingPot, Wallet, NotebookPen, Headphones, Folder, Boxes } from '@lucide/astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const content = lang === 'en' ? en : de;
const t = content.useCases;
const useCasesList = Object.values(t.items);

// Wir müssen die Icons hier manuell mappen, da sie nicht in den Übersetzungsdateien stehen sollten (technische Pfade)
const icons = {
  photos: { Glyph: Image, tech: "/icons/apps/immich-logo.svg", software: "Immich", url: "https://immich.app/" },
  documents: { Glyph: FileText, tech: "/icons/apps/paperless-ngx.svg", software: "Paperless-ngx", url: "https://docs.paperless-ngx.com/" },
  passwords: { Glyph: KeyRound, tech: "/icons/apps/vaultwarden.svg", software: "Vaultwarden", url: "https://github.com/dani-garcia/vaultwarden" },
  recipes: { Glyph: CookingPot, tech: "/icons/apps/kitchenowl.png", software: "KitchenOwl", url: "https://app.kitchenowl.org/" },
  finances: { Glyph: Wallet, tech: "/icons/apps/actual.png", software: "Actual", url: "https://actualbudget.org/" },
  notes: { Glyph: NotebookPen, tech: "/icons/apps/memos.webp", software: "Memos", url: "https://usememos.com" },
  audiobooks: { Glyph: Headphones, tech: "/icons/apps/audiobookshelf.png", software: "Audiobookshelf", url: "https://www.audiobookshelf.org/" },
  files: { Glyph: Folder, tech: "/icons/apps/filebrowser.svg", software: "Filebrowser", url: "https://filebrowser.org/" },
  more: { Glyph: Boxes, tech: "/icons/apps/opensource.svg", software: "Open Source", url: null }
};

// Wir mappen die übersetzten Texte auf die Icons
const itemsWithIcons = Object.keys(t.items).map(key => {
  const item = t.items[key as keyof typeof t.items];
  const iconData = icons[key as keyof typeof icons];
  return { ...item, ...iconData };
});
---

<section id="use-cases">
  <div class="container">
    <h2>{t.sectionTitle}</h2>
    <p class="section-description">{t.sectionDescription}</p>
    
    <label class="tech-toggle-wrapper">
      <input type="checkbox" id="tech-toggle" class="fs-toggle" />
      <span class="toggle-label">{t.toggleLabel}</span>
    </label>
    
    <div class="use-cases-grid" id="use-cases-grid">
      {itemsWithIcons.map(useCase => (
        <div class="use-case-card fs-sheet">
          <div class="card-header">
            <div class="icon-container">
              <div class="simple-icon fs-glyph"><useCase.Glyph size={22} stroke-width={1.5} aria-hidden="true" /></div>
              <div class="tech-icon">
                <img src={useCase.tech} alt={useCase.software} loading="lazy" />
              </div>
            </div>
            {useCase.software && (
              useCase.url ? (
                <a href={useCase.url} target="_blank" rel="noopener noreferrer" class="software-badge software-link">
                  {useCase.software}
                </a>
              ) : (
                <div class="software-badge">{useCase.software}</div>
              )
            )}
          </div>
          <h3>{useCase.title}</h3>
          <div class="description-container">
            <p class="simple-text">{useCase.simpleDescription}</p>
            <p class="tech-text">{useCase.techDescription}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="disclaimer-box" id="tech-disclaimer">
      <p>{t.disclaimer}</p>
    </div>
  </div>
</section>

<script>
  const techToggle = document.getElementById('tech-toggle');
  const grid = document.getElementById('use-cases-grid');
  const disclaimer = document.getElementById('tech-disclaimer');

  techToggle?.addEventListener('change', () => {
    const isTech = (techToggle as HTMLInputElement).checked;
    
    if (isTech) {
      grid?.classList.add('show-tech');
      disclaimer?.classList.add('visible');
    } else {
      grid?.classList.remove('show-tech');
      disclaimer?.classList.remove('visible');
    }
  });
</script>

<style>
  .tech-toggle-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
    cursor: pointer;
  }

  .toggle-label {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink);
  }

  .use-cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
  }

  .use-case-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-5);
    height: 44px;
  }

  .icon-container {
    position: relative;
    width: 44px;
    height: 44px;
  }

  .simple-icon, .tech-icon {
    position: absolute;
    inset: 0;
    transition: opacity var(--motion-considered) var(--ease-standard);
  }

  .tech-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
  }

  .tech-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--radius-glyph);
  }

  .software-badge {
    font: 500 11px/1 var(--font-mono);
    letter-spacing: var(--ls-mono);
    color: var(--ink-muted);
    padding: 6px 10px;
    border: var(--border-w) solid var(--border-cool);
    border-radius: var(--radius-control);
    margin-left: auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--motion-considered) var(--ease-standard),
                visibility var(--motion-considered),
                color var(--motion-instant) var(--ease-standard),
                border-color var(--motion-instant) var(--ease-standard);
  }

  .software-link {
    text-decoration: none;
  }

  .software-link:hover {
    color: var(--line);
    border-color: var(--line);
  }

  .use-case-card h3 {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-2);
  }

  .description-container {
    display: grid;
  }

  .simple-text, .tech-text {
    grid-area: 1 / 1;
    color: var(--ink-muted);
    line-height: 1.6;
    transition: opacity var(--motion-considered) var(--ease-standard);
  }

  .tech-text {
    opacity: 0;
    visibility: hidden;
  }

  /* Tech mode */
  .use-cases-grid.show-tech .simple-icon,
  .use-cases-grid.show-tech .simple-text {
    opacity: 0;
    visibility: hidden;
  }

  .use-cases-grid.show-tech .tech-icon,
  .use-cases-grid.show-tech .tech-text,
  .use-cases-grid.show-tech .software-badge {
    opacity: 1;
    visibility: visible;
  }

  .disclaimer-box {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition: opacity var(--motion-considered) var(--ease-standard),
                max-height var(--motion-considered) var(--ease-standard),
                margin-top var(--motion-considered) var(--ease-standard);
  }

  .disclaimer-box.visible {
    max-height: 200px;
    opacity: 1;
    margin-top: var(--space-7);
  }

  .disclaimer-box p {
    font-size: var(--fs-small);
    color: var(--ink-muted);
    line-height: 1.5;
  }
</style>
