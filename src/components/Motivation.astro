---
import { de } from '../i18n/de';
import { en } from '../i18n/en';
import Modal from './Modal.astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const content = lang === 'en' ? en : de;
const t = content.motivation;
const valuesList = Object.values(t.values);
---

<section id="motivation">
  <div class="container">
    <h2>{t.sectionTitle}</h2>
    <p class="section-description">{t.sectionDescription}</p>
    <div class="motivation-content">
      <div class="motivation-text">
        <h3>{t.story.title}</h3>
        {t.story.paragraphs.map(p => <p set:html={p} />)}
      </div>
      <div class="motivation-stats">
        {valuesList.map(item => (
          <>
            <button type="button" class="stat-card fs-focusable" data-modal-trigger={item.link} aria-haspopup="dialog">
              <div class="stat-number">{item.value}</div>
              <div class="stat-label fs-label">{item.label}</div>
            </button>
            <Modal id={item.link} title={item.title} content={item.explanation} />
          </>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .motivation-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: start;
  }

  .motivation-text h3 {
    margin-bottom: var(--space-5);
  }

  .motivation-text p {
    margin-bottom: var(--space-5);
    color: var(--ink-muted);
    font-size: var(--fs-prose);
    line-height: 1.75;
  }

  .motivation-text p :global(a) {
    color: var(--line);
  }

  .motivation-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .stat-card {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    padding: var(--space-6) var(--space-4);
    border-radius: var(--radius-tile);
    border: var(--border-w) solid var(--border-cool);
    text-align: center;
    display: block;
    cursor: pointer;
    transition: border-color var(--motion-instant) var(--ease-standard);
  }

  .stat-card:hover {
    border-color: var(--line);
  }

  .stat-number {
    font-size: var(--fs-h1);
    font-weight: 600;
    color: var(--line);
    margin-bottom: var(--space-3);
  }

  @media (max-width: 768px) {
    .motivation-content {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const triggers = document.querySelectorAll('[data-modal-trigger]');

    triggers.forEach(trigger => {
      trigger.addEventListener('click', () => {
        const modalId = trigger.getAttribute('data-modal-trigger');
        const modal = document.querySelector<HTMLDialogElement>(`dialog[data-modal-id="${modalId}"]`);
        modal?.showModal();
      });
    });
  });
</script>
