---
import { de } from '../i18n/de';
import { en } from '../i18n/en';
import { ShieldCheck, CircleUserRound, RefreshCw, MonitorSmartphone, FolderOpen, LayoutGrid } from '@lucide/astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const content = lang === 'en' ? en : de;
const t = content.features;

const glyphs = {
  independence: ShieldCheck,
  managed: CircleUserRound,
  privacy: RefreshCw,
  central: MonitorSmartphone,
  fair: FolderOpen,
  support: LayoutGrid,
};

const featuresList = Object.entries(t.items).map(([key, item]) => ({
  ...item,
  Glyph: glyphs[key as keyof typeof glyphs],
}));
---

<section id="features">
  <div class="container">
    <h2>{t.sectionTitle}</h2>
    <p class="section-description">{t.sectionDescription}</p>
    <div class="features-grid">
      {featuresList.map(feature => (
        <div class="feature-card fs-sheet">
          <div class="fs-glyph"><feature.Glyph size={22} stroke-width={1.5} aria-hidden="true" /></div>
          <h3>{feature.title}</h3>
          <p>{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
  }

  .feature-card {
    padding: var(--space-6);
  }

  .feature-card .fs-glyph {
    margin-bottom: var(--space-5);
  }

  .feature-card p {
    color: var(--ink-muted);
    line-height: 1.6;
  }
</style>
