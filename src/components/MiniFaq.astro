---
import { de } from '../i18n/de';
import { en } from '../i18n/en';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const content = lang === 'en' ? en : de;
const t = content.miniFaq;
---

<section id="mini-faq" class="mini-faq">
  <div class="container">
    <h2>{t.title}</h2>
    <p class="section-description">{t.description}</p>
    <div class="mini-faq-grid">
      {t.items.map(item => (
        <div class="mini-faq-card fs-sheet">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </div>
      ))}
    </div>
    <div class="mini-faq-link">
      <a href={`/${lang}/faq/`} class="fs-btn">{t.linkText}</a>
    </div>
  </div>
</section>

<style>
  .mini-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .mini-faq-card h3 {
    font-size: var(--fs-h3);
    margin-bottom: var(--space-3);
  }

  .mini-faq-card p {
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .mini-faq-link {
    text-align: center;
    margin-top: var(--space-7);
  }
</style>
