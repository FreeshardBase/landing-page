---
import { de } from '../i18n/de';
import { en } from '../i18n/en';
import { Sprout, Camera, House, Gem, Rocket } from '@lucide/astro';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const content = lang === 'en' ? en : de;
const t = content.pricing;
---

<section id="pricing">
  <div class="container">
    <h2>{t.pageTitle}</h2>

    <div class="pricing-intro">
      <p>{t.info.introText}</p>
      <a href={`/${lang}/trial/`} class="fs-btn">{t.info.trialCta}</a>
    </div>
    
    <div class="pricing-container">
      <div class="presets">
        <h3>{t.presetsTitle}</h3>
        <div class="preset-grid">
          <button type="button" class="preset-card fs-focusable" data-vm-tier="xs" data-disk="10" aria-pressed="false">
            <span class="fs-glyph"><Sprout size={22} stroke-width={1.5} aria-hidden="true" /></span>
            <span class="preset-name">{t.presets.starter.name}</span>
            <span class="preset-specs fs-mono">1 vCore, 2 GB RAM</span>
            <span class="preset-description">{t.presets.starter.description}</span>
          </button>
          <button type="button" class="preset-card fs-focusable" data-vm-tier="s" data-disk="50" aria-pressed="false">
            <span class="fs-glyph"><Camera size={22} stroke-width={1.5} aria-hidden="true" /></span>
            <span class="preset-name">{t.presets.collector.name}</span>
            <span class="preset-specs fs-mono">2 vCores, 4 GB RAM</span>
            <span class="preset-description">{t.presets.collector.description}</span>
          </button>
          <button type="button" class="preset-card fs-focusable" data-vm-tier="m" data-disk="250" aria-pressed="false">
            <span class="fs-glyph"><House size={22} stroke-width={1.5} aria-hidden="true" /></span>
            <span class="preset-name">{t.presets.family.name}</span>
            <span class="preset-specs fs-mono">4 vCores, 8 GB RAM</span>
            <span class="preset-description">{t.presets.family.description}</span>
          </button>
          <button type="button" class="preset-card fs-focusable" data-vm-tier="l" data-disk="250" aria-pressed="false">
            <span class="fs-glyph"><Gem size={22} stroke-width={1.5} aria-hidden="true" /></span>
            <span class="preset-name">Premium</span>
            <span class="preset-specs fs-mono">4 vCores, 16 GB RAM</span>
            <span class="preset-description">For demanding workloads and multiple concurrent users.</span>
          </button>
          <button type="button" class="preset-card fs-focusable" data-vm-tier="xl" data-disk="500" aria-pressed="false">
            <span class="fs-glyph"><Rocket size={22} stroke-width={1.5} aria-hidden="true" /></span>
            <span class="preset-name">{t.presets.enthusiast.name}</span>
            <span class="preset-specs fs-mono">8 vCores, 32 GB RAM</span>
            <span class="preset-description">{t.presets.enthusiast.description}</span>
          </button>
        </div>
      </div>

      <div class="calculator-wrapper">
        <div class="calculator fs-sheet">
          <div class="slider-group">
            <label for="disk-size">
              <span class="slider-label">{t.calculator.diskLabel}</span>
              <span class="slider-value fs-mono" id="disk-value">30</span>
            </label>
            <input type="range" id="disk-size" min="0" max="12" value="1" step="1" class="slider"/>
            <div class="slider-markers fs-mono" aria-hidden="true"><span>20</span><span>50</span><span>130</span><span>250</span><span>400</span></div>
          </div>
        </div>
      </div>

      <div class="price-summary fs-sheet">
        <div class="breakdown-total">
          <span>{t.summary.totalLabel}</span>
          <span id="total-price" class="total-price fs-mono"></span>
        </div>
        <div id="vat-note" class="vat-note"></div>
        <div class="cta-wrapper">
          <a href={`/${lang}/trial/`} class="fs-btn fs-btn--primary">{t.summary.ctaButton}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ t }}>
  // --- Pricing Data ---
  const vmPricing = {
    'xs': 5.50,
    's': 11.00,
    'm': 19.80,
    'l': 51.00,
    'xl': 102.00
  };
  const diskPricePerGB = 0.04;

  // Allowed disk sizes (GB)
  const allowedDiskSizes = [20, 30, 40, 50, 80, 100, 130, 170, 200, 250, 300, 350, 400];

  // --- Konstanten und DOM-Elemente ---
  const diskSizeEl = document.getElementById('disk-size');

  let currentVMTier = 's'; // Default to 's' tier

  function getDiskSizeFromSlider(sliderValue) {
    return allowedDiskSizes[sliderValue];
  }

  function calculatePrice() {
    const sliderIndex = parseInt(diskSizeEl.value);
    const diskSize = getDiskSizeFromSlider(sliderIndex);
    const vmCost = vmPricing[currentVMTier];
    const diskCost = diskSize * diskPricePerGB;
    const totalCost = (vmCost + diskCost) * 1.5 * 1.19; // *1.5 markup, *1.19 German VAT

    document.getElementById('total-price').textContent = `€${totalCost.toFixed(2)}`;

    // VAT share of the gross price (gross already includes 19% VAT)
    const grossCents = Math.round(totalCost * 100);
    const vatCents = grossCents - Math.round(grossCents / 1.19);
    document.getElementById('vat-note').textContent =
      t.summary.vatNote.replace('{amount}', `€${(vatCents / 100).toFixed(2)}`);
  }

  function updateActiveCard() {
    document.querySelectorAll('.preset-card').forEach(card => {
      const active = card.dataset.vmTier === currentVMTier;
      card.classList.toggle('active', active);
      card.setAttribute('aria-pressed', active.toString());
    });
  }

  function updateDisplay() {
    if (!diskSizeEl) return;

    const sliderIndex = parseInt(diskSizeEl.value);
    const diskSize = getDiskSizeFromSlider(sliderIndex);
    document.getElementById('disk-value').textContent = diskSize.toString();

    calculatePrice();
  }

  // --- Event-Listener ---
  diskSizeEl?.addEventListener('input', updateDisplay);

  document.querySelectorAll('.preset-card').forEach(card => {
    card.addEventListener('click', (e) => {
      const target = e.currentTarget;
      const vmTier = target.dataset.vmTier;

      if (vmTier) {
        currentVMTier = vmTier;
        calculatePrice();
        updateActiveCard();
      }
    });
  });

  // --- Initialisierung ---
  document.addEventListener('DOMContentLoaded', () => {
    // Start with 30 GB (index 1)
    diskSizeEl.value = "1";
    updateDisplay();
    updateActiveCard();
  });
</script>

<style>
  .pricing-container { max-width: 960px; margin: 0 auto; }

  .pricing-intro {
    text-align: center;
    margin-bottom: var(--space-7);
  }

  .pricing-intro p {
    color: var(--ink-muted);
    font-size: 17px;
    max-width: 640px;
    margin: 0 auto var(--space-5);
  }

  .presets { margin-bottom: var(--space-5); text-align: center; }
  .presets h3 { margin-bottom: var(--space-5); }

  .preset-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-3); }

  .preset-card {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    padding: var(--space-5) var(--space-4);
    border-radius: var(--radius-tile);
    border: var(--border-w) solid var(--border-cool);
    cursor: pointer;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: border-color var(--motion-instant) var(--ease-standard);
  }
  .preset-card:hover { border-color: var(--line); }
  .preset-card.active { border-color: var(--data); box-shadow: inset 0 0 0 0.5px var(--data); }
  .preset-card .fs-glyph { width: 40px; height: 40px; margin-bottom: var(--space-4); }
  .preset-name { display: block; font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-1); }
  .preset-specs { display: block; color: var(--ink); font-size: 11px; margin-bottom: var(--space-3); }
  .preset-description { display: block; color: var(--ink-muted); font-size: var(--fs-small); line-height: 1.5; flex-grow: 1; }

  .calculator {
    margin-top: var(--space-5);
    padding: var(--space-6);
  }
  .slider-group label { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-4); }
  .slider-label { color: var(--ink); font-weight: 500; }
  .slider-value { color: var(--ink); font-size: var(--fs-h3); }

  .slider {
    width: 100%;
    height: 18px;
    background: transparent;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }
  .slider::-webkit-slider-runnable-track { height: 1.5px; background: var(--border-cool); }
  .slider::-moz-range-track { height: 1.5px; background: var(--border-cool); }
  .slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px; height: 18px; margin-top: -8.25px;
    border-radius: 50%;
    background: var(--surface);
    border: var(--border-w-glyph) solid var(--data);
  }
  .slider::-moz-range-thumb {
    width: 15px; height: 15px;
    border-radius: 50%;
    background: var(--surface);
    border: var(--border-w-glyph) solid var(--data);
  }
  /* Markers sit on slider steps 0, 3, 6, 9, 12; padded by half a thumb so each label centres on its stop. */
  .slider-markers {
    display: flex;
    justify-content: space-between;
    margin: var(--space-2) 0 0;
    font-size: 11px;
    color: var(--ink-muted);
  }
  .slider-markers span { width: 18px; text-align: center; }

  .price-summary {
    margin-top: var(--space-5);
    padding: var(--space-6);
    text-align: center;
  }
  .breakdown-total { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-1); }
  .breakdown-total > span:first-child { font-size: var(--fs-h2); font-weight: 600; }
  .total-price { font-size: var(--fs-h1); font-weight: 500; color: var(--ink); }
  .vat-note { font-size: var(--fs-small); color: var(--ink-muted); text-align: right; margin-bottom: var(--space-5); }
  .cta-wrapper { margin-top: var(--space-4); }

  @media (max-width: 1100px) {
    .preset-grid { grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); }
  }

  @media (max-width: 768px) {
    .preset-grid { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
    .breakdown-total { flex-direction: column; align-items: center; gap: var(--space-2); }
    .vat-note { text-align: center; }
  }
</style>
